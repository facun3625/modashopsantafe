# Postgres local (levantado con `docker compose up -d db`)
DATABASE_URL="postgresql://modashop:modashop@localhost:5439/modashop?schema=public"

# NextAuth (generar con: openssl rand -base64 32 — usar una clave DISTINTA en cada
# instalación/franquicia, nunca reusar la misma entre entornos)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Login con Google (Google Cloud Console → APIs & Services → Credentials).
# Necesita su propio redirect URI autorizado por dominio:
# https://<tu-dominio>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Pago (si no se usa todavía, puede quedar vacío)
MERCADOPAGO_ACCESS_TOKEN=

# La conexión con Odoo (URL/DB/usuario/API key) y el SMTP del mailing NO van
# acá — se cargan desde el admin, en Configuración, una vez que el sitio ya
# está arriba. Cada franquicia/instalación tiene los suyos propios.
